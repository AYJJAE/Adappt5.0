# ==========================================
# Vanguard Hazard Intelligence Environment Keys (Example)
# Copy this file to .env and populate with your own API credentials
# ==========================================

# Open-Meteo Weather API Endpoint (Free, open source)
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast?latitude=52.52&longitude=13.41&hourly=temperature_2m"

# OpenRouteService / Token
OPENROUTE_SERVICE_TOKEN="your_openrouteservice_token_here"

# NASA GIBS / FIRMS Map Key
NASA_MAP_KEY="your_nasa_map_key_here"

# Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Google Maps API Key
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
